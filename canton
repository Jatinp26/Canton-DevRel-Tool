#!/usr/bin/env bash

set -euo pipefail
CANTON_DEVREL_DIR="${CANTON_DEVREL_DIR:-${CANTON_BUILDER_DIR:-$HOME/.canton-builder}}"
VERSION="2.0.0"

usage() {
  cat <<EOF
  Canton Builder Tool CLI  (v${VERSION})

  USAGE
    canton builder <command> [args]

  COMMANDS
    start [flags]       Boot Canton LocalNet (participants, wallets, scan, onboarding)
    stop                Stop all LocalNet containers (data preserved)
    status              Show health and port reference for all services
    env                 Print parties, credentials, API URLs, and tokens for the running net
    token [--validator <n>]
                        Print a bearer token for a participant's Ledger API
    deploy <file.dar>   Upload a prebuilt DAR to App Provider + App User participants
    logs [service]      Tail container logs (optionally filter to one service)
    reset               Wipe all data and stop containers, full clean slate
    validator <verb>    Manage validators (list, add, start, stop, rm, info)
    version             Print version info

  START FLAGS
    --auth              Enable Keycloak (OAuth2 / OIDC client-credentials)
    --pqs               Enable Participant Query Store (PQS)
    --with <name>       Add a validator to the active set (e.g. app-user)
    --without <name>    Remove a validator from the active set
    --only <list>       Absolute active set (comma-separated)

  EXAMPLES
    canton builder start
    canton builder start --auth --with app-user
    canton builder env
    canton builder token --validator app-provider
    canton builder deploy ./my-app/.daml/dist/my-app-0.0.1.dar
    canton builder logs splice
    canton builder reset

  SERVICES FOR LOGS
    canton              Canton participant node
    splice              Splice validators + wallet UIs
    postgres            PostgreSQL
    keycloak            Keycloak OAuth2            (only with --auth)
    pqs-app-provider    Participant Query Store    (only with --pqs)
    json-api-app-provider
    json-api-app-user

  PORTS (after start)
    App Provider JSON API  →  http://localhost:3975
    App User JSON API      →  http://localhost:2975
    App Provider Wallet    →  http://wallet.localhost:3000
    App User Wallet        →  http://wallet.localhost:2000
    Scan UI                →  http://scan.localhost:4000
    SV UI                  →  http://sv.localhost:4000
    Keycloak               →  http://keycloak.localhost:8082   (only with --auth)

  AUTH
    Default: self-signed HS256 tokens (mint one with 'canton builder token').
    With --auth: Keycloak issues OAuth2 tokens; realms AppProvider / AppUser,
    admin console at http://keycloak.localhost:8082 (admin / admin).
    Wallet UI logins: app-user / app-provider.

EOF
}

if [[ "${1:-}" == "version" || "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
  echo "canton builder v${VERSION}"
  exit 0
fi

SUBCOMMAND="${1:-}"
BUILDER_COMMAND="${2:-}"
if [[ "$SUBCOMMAND" != "builder" ]]; then
  echo ""
  echo "  Unknown command: ${SUBCOMMAND}"
  usage
  exit 1
fi

case "$BUILDER_COMMAND" in
  start)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/start.sh" "$@"
    ;;
  stop)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/stop.sh" "$@"
    ;;
  status)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/status.sh" "$@"
    ;;
  env)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/env.sh" "$@"
    ;;
  token)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/token.sh" "$@"
    ;;
  deploy)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/deploy.sh" "$@"
    ;;
  logs)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/logs.sh" "${@:-}"
    ;;
  reset)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/reset.sh" "$@"
    ;;
  validator)
    shift 2
    exec "$CANTON_DEVREL_DIR/scripts/validator.sh" "$@"
    ;;
  version|--version|-v)
    echo "canton builder v${VERSION}"
    ;;
  ""|help|--help|-h)
    usage
    ;;
  *)
    echo ""
    echo "  Unknown builder command: $BUILDER_COMMAND"
    usage
    exit 1
    ;;
esac

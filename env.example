# Canton Builder Tool configuration
# Copy to ~/.canton-builder/.env to override any of these.

# Splice version also used as the container image tag (IMAGE_TAG).
SPLICE_VERSION=0.6.11

# cn-quickstart ref the LocalNet compose modules are fetched from.
# Pin to a commit SHA for reproducibility (or a branch/tag to track upstream).
CNQS_REF=93f97b34eb47709e6484eb2e3dc6f722d328063b

# Base directory for fetched modules and runtime state.
CANTON_BUILDER_DIR=$HOME/.canton-builder

# Party hint for LocalNet (format: <company>-<role>-<number>).
PARTY_HINT=builder-localnet-1

# Self-signed JWT secret (default auth model). Leave as 'unsafe' for LocalNet.
SPLICE_APP_UI_UNSAFE_SECRET=unsafe
